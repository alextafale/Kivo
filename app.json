{
  "expo": {
    "name": "Kivo",
    "slug": "Kivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/KIVO.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/KIVO.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pidelo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/KIVO.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pidelo.app"
    },
    "web": {
      "favicon": "./assets/KIVO.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/KIVO.png",
          "color": "#22c55e",
          "androidMode": "default",
          "androidCollapsedTitle": "Kivo",
          "iosDisplayInForeground": true
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "66d69eb3-0d57-42f8-84f3-5998e544e941"
      }
    }
  }
}
